<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#7457e8">
    <title><%= payment ? ('Pembayaran ' + formatRupiah(payment.amount) + ' — ' + storeName) : ('Pembayaran QRIS — ' + appName) %></title>
    
    <!-- QRCode JS & Canvas Confetti -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
    
    <!-- Google Fonts & Font Awesome 6 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        :root {
            --primary: #7457e8;
            --primary-hover: #6044d0;
            --primary-light: #eeeaff;
            --bg: #f5f6fb;
            --card: #ffffff;
            --surface: #fafaff;
            --text: #19192c;
            --muted: #85859c;
            --border: #e9e9f1;
            --success: #159b69;
            --success-bg: #e6f7f0;
            --warning: #d9912b;
            --warning-bg: #fff5e7;
            --danger: #e11d48;
            --danger-bg: #ffe4e6;
            --shadow: 0 15px 50px rgba(35,30,80,.07);
        }

        [data-theme="dark"] {
            --primary: #8a70ff;
            --primary-hover: #7457e8;
            --primary-light: #2b254a;
            --bg: #10111a;
            --card: #191a27;
            --surface: #202131;
            --text: #f2f2fa;
            --muted: #9999b0;
            --border: #303144;
            --success: #38c994;
            --success-bg: #143527;
            --warning: #f1b454;
            --warning-bg: #3c2a13;
            --danger: #fb7185;
            --danger-bg: #3d1620;
            --shadow: 0 15px 50px rgba(0,0,0,.25);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: background .25s ease, color .25s ease;
            -webkit-tap-highlight-color: transparent;
        }

        button, a {
            font: inherit;
            cursor: pointer;
            text-decoration: none;
        }

        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }

        /* HEADER */
        .header {
            height: 72px;
            padding: 0 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
            background: var(--card);
            position: sticky;
            top: 0;
            z-index: 40;
            backdrop-filter: blur(10px);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #886cff, #6044d0);
            border-radius: 12px;
            display: grid;
            place-items: center;
            color: #ffffff;
            font-size: 20px;
            font-weight: 900;
            box-shadow: 0 6px 16px rgba(116, 87, 232, 0.35);
        }

        .brand-meta {
            display: flex;
            flex-direction: column;
        }

        .brand-name {
            font-size: 19px;
            font-weight: 850;
            letter-spacing: -.6px;
            line-height: 1.1;
        }

        .brand-name span {
            color: var(--primary);
        }

        .brand-sub {
            font-size: 11px;
            color: var(--muted);
            font-weight: 600;
            margin-top: 2px;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .secure-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--success);
            background: var(--success-bg);
            padding: 6px 12px;
            border-radius: 99px;
            font-size: 11.5px;
            font-weight: 700;
        }

        .theme-btn {
            width: 38px;
            height: 38px;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--text);
            border-radius: 10px;
            font-size: 15px;
            display: grid;
            place-items: center;
            transition: all .2s;
        }

        .theme-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        /* MAIN CONTAINER */
        .main {
            width: 100%;
            max-width: 1060px;
            padding: 36px 20px 48px;
            margin: 0 auto;
            flex: 1;
        }

        .page-heading {
            margin-bottom: 24px;
        }

        .page-heading h1 {
            font-size: 24px;
            font-weight: 850;
            letter-spacing: -.7px;
        }

        .page-heading p {
            font-size: 13px;
            color: var(--muted);
            margin-top: 5px;
        }

        /* PAYMENT GRID */
        .payment-grid {
            display: grid;
            grid-template-columns: 1fr 390px;
            gap: 24px;
            align-items: start;
        }

        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 20px;
            box-shadow: var(--shadow);
            overflow: hidden;
            transition: border-color .2s;
        }

        .card-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-header h2 {
            font-size: 15px;
            font-weight: 800;
            letter-spacing: -.3px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .qris-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 11px;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 13px;
            font-weight: 900;
            letter-spacing: -.5px;
            background: var(--surface);
        }

        .qris-symbol {
            width: 18px;
            height: 18px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2.5px;
        }

        .qris-symbol i {
            background: #168d69;
            border-radius: 2px;
        }

        .qris-symbol i:nth-child(2),
        .qris-symbol i:nth-child(3) {
            opacity: .45;
        }

        /* QR CONTENT */
        .qr-content {
            padding: 28px 24px;
            text-align: center;
        }

        .qr-caption {
            font-size: 12.5px;
            color: var(--muted);
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .qr-frame {
            width: 280px;
            max-width: 100%;
            padding: 16px;
            background: #ffffff;
            border-radius: 18px;
            margin: 0 auto;
            box-shadow: 0 8px 30px rgba(0,0,0,.08);
            position: relative;
            border: 2px solid #f1effe;
        }

        #qrcode {
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 248px;
        }

        #qrcode img,
        #qrcode canvas {
            max-width: 100% !important;
            height: auto !important;
            margin: 0 auto;
            border-radius: 8px;
            display: block;
        }

        .qris-sublabel {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 14px;
            padding: 5px 11px;
            background: var(--surface);
            color: var(--muted);
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .4px;
        }

        .timer-container {
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 14px 18px;
            border-radius: 14px;
            margin-top: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .timer-label {
            font-size: 11.5px;
            color: var(--muted);
            font-weight: 600;
            text-align: left;
        }

        .timer {
            font-size: 23px;
            font-weight: 900;
            color: var(--primary);
            letter-spacing: 1.5px;
        }

        /* STATUS BADGE */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--warning-bg);
            color: var(--warning);
            padding: 6px 14px;
            border-radius: 99px;
            font-size: 11.5px;
            font-weight: 800;
            margin-top: 18px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: var(--warning);
            border-radius: 50%;
            animation: pulse-dot 1.5s infinite;
        }

        @keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: .3; transform: scale(.8); }
        }

        /* SUMMARY CARD */
        .summary {
            padding: 24px;
        }

        .amount-label {
            font-size: 12px;
            color: var(--muted);
            font-weight: 600;
        }

        .amount {
            font-size: 32px;
            font-weight: 900;
            letter-spacing: -1.2px;
            color: var(--text);
            margin-top: 4px;
        }

        .merchant {
            font-size: 13px;
            margin-top: 8px;
            color: var(--muted);
        }

        .merchant strong {
            color: var(--text);
        }

        .divider {
            border: none;
            border-top: 1px dashed var(--border);
            margin: 20px 0;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
            font-size: 12.5px;
        }

        .detail-row:last-child {
            margin-bottom: 0;
        }

        .detail-label {
            color: var(--muted);
            font-weight: 500;
        }

        .detail-value {
            font-weight: 700;
            text-align: right;
            color: var(--text);
        }

        .copy-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--primary-light);
            color: var(--primary);
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            border: none;
            transition: all .2s;
        }

        .copy-pill:hover {
            opacity: .85;
            transform: translateY(-1px);
        }

        /* INSTRUCTIONS */
        .instructions {
            padding: 22px 24px;
            border-top: 1px solid var(--border);
        }

        .instructions h3 {
            font-size: 14px;
            font-weight: 800;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .step-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .step-item {
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

        .step-num {
            min-width: 24px;
            height: 24px;
            display: grid;
            place-items: center;
            border-radius: 7px;
            background: var(--primary-light);
            color: var(--primary);
            font-size: 11px;
            font-weight: 800;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .step-item p {
            font-size: 12px;
            color: var(--muted);
            line-height: 1.55;
        }

        /* SUCCESS STATE HERO */
        .success-hero {
            text-align: center;
            padding: 42px 28px;
        }

        .success-icon-wrap {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--success-bg);
            color: var(--success);
            display: grid;
            place-items: center;
            font-size: 38px;
            margin: 0 auto 20px;
            box-shadow: 0 10px 30px rgba(21, 155, 105, 0.2);
            animation: bounce-scale .5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes bounce-scale {
            0% { transform: scale(0.3); opacity: 0; }
            70% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }

        .success-hero h2 {
            font-size: 24px;
            font-weight: 850;
            letter-spacing: -.6px;
            color: var(--text);
        }

        .success-hero p {
            font-size: 13.5px;
            color: var(--muted);
            margin-top: 6px;
            max-width: 460px;
            margin-left: auto;
            margin-right: auto;
        }

        .success-amount-pill {
            display: inline-block;
            margin-top: 16px;
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 10px 22px;
            border-radius: 99px;
            font-size: 20px;
            font-weight: 900;
            color: var(--success);
            letter-spacing: -.5px;
        }

        /* EXPIRED STATE HERO */
        .expired-hero {
            text-align: center;
            padding: 42px 28px;
        }

        .expired-icon-wrap {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--danger-bg);
            color: var(--danger);
            display: grid;
            place-items: center;
            font-size: 34px;
            margin: 0 auto 20px;
        }

        .expired-hero h2 {
            font-size: 23px;
            font-weight: 850;
            letter-spacing: -.6px;
        }

        .expired-hero p {
            font-size: 13.5px;
            color: var(--muted);
            margin-top: 6px;
            max-width: 440px;
            margin-left: auto;
            margin-right: auto;
        }

        /* ACTIONS */
        .btn-action-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--primary);
            color: #ffffff;
            font-size: 13.5px;
            font-weight: 700;
            padding: 12px 24px;
            border-radius: 12px;
            border: none;
            transition: all .2s;
            box-shadow: 0 4px 14px rgba(116, 87, 232, 0.3);
        }

        .btn-action-primary:hover {
            background: var(--primary-hover);
            transform: translateY(-1px);
        }

        .btn-action-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--surface);
            color: var(--text);
            border: 1px solid var(--border);
            font-size: 13.5px;
            font-weight: 700;
            padding: 12px 24px;
            border-radius: 12px;
            transition: all .2s;
        }

        .btn-action-secondary:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        /* REDIRECT COUNTDOWN BAR */
        .redirect-bar-container {
            margin-top: 24px;
            padding: 14px 18px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            max-width: 480px;
            margin-left: auto;
            margin-right: auto;
        }

        .redirect-bar-track {
            height: 6px;
            background: var(--border);
            border-radius: 99px;
            overflow: hidden;
            margin-top: 10px;
        }

        .redirect-bar-fill {
            height: 100%;
            background: var(--primary);
            width: 100%;
            transition: width 1s linear;
        }

        /* FOOTER */
        .footer {
            text-align: center;
            padding: 24px 20px;
            color: var(--muted);
            font-size: 11.5px;
            line-height: 1.8;
            border-top: 1px solid var(--border);
            background: var(--card);
        }

        .footer strong {
            color: var(--text);
        }

        /* TOAST */
        .toast {
            position: fixed;
            left: 50%;
            bottom: 28px;
            transform: translate(-50%, 20px);
            background: #191a27;
            color: #ffffff;
            padding: 10px 18px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 600;
            opacity: 0;
            transition: all .25s ease;
            pointer-events: none;
            z-index: 100;
            box-shadow: 0 10px 30px rgba(0,0,0,.3);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .toast.show {
            opacity: 1;
            transform: translate(-50%, 0);
        }

        /* RESPONSIVE */
        @media (max-width: 860px) {
            .payment-grid {
                grid-template-columns: 1fr;
            }
            .main {
                padding-top: 24px;
            }
            .header {
                padding: 0 16px;
            }
            .amount {
                font-size: 28px;
            }
            .qr-frame {
                width: 250px;
            }
            #qrcode {
                min-height: 218px;
            }
        }

        @media print {
            .header, .instructions, .footer, .theme-btn, .btn-action-primary, .btn-action-secondary, .redirect-bar-container {
                display: none !important;
            }
            body {
                background: white !important;
                color: black !important;
            }
            .card {
                border: 1px solid #ccc !important;
                box-shadow: none !important;
            }
        }
    </style>
</head>
<body>

    <!-- TOP HEADER -->
    <header class="header">
        <div class="brand">
            <div class="logo">Y</div>
            <div class="brand-meta">
                <div class="brand-name">YURI<span>PAY</span></div>
                <div class="brand-sub">Sistem Pembayaran QRIS</div>
            </div>
        </div>

        <div class="header-right">
            <div class="secure-badge">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Aman &amp; Terverifikasi</span>
            </div>
            <button class="theme-btn" id="theme-toggle" aria-label="Toggle Mode" onclick="toggleTheme()">
                <i class="fa-solid fa-moon" id="theme-icon"></i>
            </button>
        </div>
    </header>

    <!-- MAIN BODY -->
    <main class="main">
        <% if (error || !payment) { %>
            <!-- ERROR / NOT FOUND STATE -->
            <div class="card" style="max-width: 580px; margin: 40px auto; text-align: center; padding: 48px 24px;">
                <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--danger-bg); color: var(--danger); display: grid; place-items: center; font-size: 32px; margin: 0 auto 20px;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h2 style="font-size: 22px; font-weight: 850; margin-bottom: 8px;">Tagihan Tidak Ditemukan</h2>
                <p style="font-size: 13.5px; color: var(--muted); margin-bottom: 24px; line-height: 1.6;">
                    <%= error || 'Kode pembayaran salah, telah kadaluarsa, atau sudah dihapus oleh sistem.' %>
                </p>
                <div>
                    <a href="javascript:window.history.back()" class="btn-action-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Kembali
                    </a>
                </div>
            </div>
        <% } else if (payment.status === 'PAID') { %>
            <!-- SUCCESS STATE DIRECT SSR -->
            <div class="card" style="max-width: 620px; margin: 20px auto;">
                <div class="success-hero">
                    <div class="success-icon-wrap">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <h2>Pembayaran Berhasil!</h2>
                    <p>Terima kasih, pembayaran Anda telah diverifikasi otomatis oleh jaringan QRIS Nasional.</p>
                    <div class="success-amount-pill font-mono">
                        <%= formatRupiah(payment.amount) %>
                    </div>
                </div>

                <div class="summary" style="border-top: 1px solid var(--border);">
                    <div class="detail-row">
                        <span class="detail-label">Merchant</span>
                        <span class="detail-value"><%= storeName %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Nomor Pesanan</span>
                        <span class="detail-value font-mono"><%= payment.order_id %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">ID Transaksi</span>
                        <span class="detail-value font-mono" style="font-size: 11px;"><%= payment.payment_id %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Waktu Pembayaran</span>
                        <span class="detail-value font-mono"><%= payment.paid_at ? new Date(payment.paid_at).toLocaleString('id-ID') : new Date().toLocaleString('id-ID') %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Metode Pembayaran</span>
                        <span class="detail-value" style="color: var(--success); font-weight: 800;">QRIS GO-PAY VERIFIED</span>
                    </div>
                    
                    <div class="divider"></div>

                    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
                        <button onclick="window.print()" class="btn-action-secondary">
                            <i class="fa-solid fa-print"></i> Cetak Bukti Bayar
                        </button>
                        <% if (payment.redirect_url) { %>
                            <a id="btn-redirect-now" href="<%= payment.redirect_url %>" class="btn-action-primary">
                                <span>Lanjutkan</span> <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        <% } %>
                    </div>

                    <% if (payment.redirect_url) { %>
                        <div class="redirect-bar-container">
                            <div style="display: flex; justify-content: space-between; font-size: 11.5px; color: var(--muted); font-weight: 600;">
                                <span>Mengalihkan otomatis ke website toko...</span>
                                <span class="font-mono" id="redirect-countdown">5s</span>
                            </div>
                            <div class="redirect-bar-track">
                                <div class="redirect-bar-fill" id="redirect-progress"></div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        <% } else if (payment.status === 'EXPIRED') { %>
            <!-- EXPIRED STATE DIRECT SSR -->
            <div class="card" style="max-width: 600px; margin: 30px auto;">
                <div class="expired-hero">
                    <div class="expired-icon-wrap">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                    <h2>Waktu Pembayaran Habis</h2>
                    <p>Batas waktu pembayaran untuk transaksi ini telah berakhir. Silakan lakukan pemesanan ulang untuk memperoleh kode QRIS yang baru.</p>
                </div>

                <div class="summary" style="border-top: 1px solid var(--border);">
                    <div class="detail-row">
                        <span class="detail-label">Nomor Pesanan</span>
                        <span class="detail-value font-mono"><%= payment.order_id %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Total Tagihan</span>
                        <span class="detail-value font-mono" style="color: var(--muted);"><%= formatRupiah(payment.amount) %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Status</span>
                        <span class="detail-value" style="color: var(--danger);">KADALUARSA (EXPIRED)</span>
                    </div>

                    <div class="divider"></div>

                    <div style="text-align: center;">
                        <a href="javascript:window.history.back()" class="btn-action-primary">
                            <i class="fa-solid fa-arrow-left"></i> Buat Pesanan Baru
                        </a>
                    </div>
                </div>
            </div>
        <% } else { %>
            <!-- PENDING STATE (LIVE DYNAMIC INTERFACE) -->
            <div id="stage-pending">
                <div class="page-heading">
                    <h1>Pembayaran QRIS</h1>
                    <p>Scan kode QRIS menggunakan e-wallet atau mobile banking favorit Anda</p>
                </div>

                <div class="payment-grid">
                    <!-- LEFT COLUMN: QR CODE & INSTRUCTIONS -->
                    <div style="display: flex; flex-direction: column; gap: 24px;">
                        <div class="card">
                            <div class="card-header">
                                <h2>
                                    <i class="fa-solid fa-qrcode" style="color: var(--primary);"></i>
                                    <span>Scan QRIS</span>
                                </h2>
                                <div class="qris-badge">
                                    <div class="qris-symbol">
                                        <i></i><i></i><i></i><i></i>
                                    </div>
                                    <span>QRIS</span>
                                </div>
                            </div>

                            <div class="qr-content">
                                <p class="qr-caption">
                                    Buka aplikasi GoPay, OVO, Dana, BCA, Livin Mandiri, atau bank lain dan scan kode di bawah ini:
                                </p>

                                <div class="qr-frame">
                                    <div id="qrcode"></div>
                                </div>

                                <div>
                                    <span class="qris-sublabel">
                                        <i class="fa-solid fa-shield-check" style="color: var(--success);"></i>
                                        STANDAR QRIS NASIONAL (NMID TERVERIFIKASI)
                                    </span>
                                </div>

                                <div class="timer-container">
                                    <div class="timer-label">
                                        <div>Sisa Waktu Pembayaran</div>
                                        <div style="font-size: 10px; color: var(--muted); margin-top: 2px;">Otomatis diverifikasi seketika</div>
                                    </div>
                                    <div class="timer font-mono" id="countdown-display">--:--</div>
                                </div>

                                <div>
                                    <div class="status-badge">
                                        <div class="status-dot"></div>
                                        <span>Menunggu Pembayaran</span>
                                    </div>
                                </div>
                            </div>

                            <!-- INSTRUCTIONS ACCORDION -->
                            <div class="instructions">
                                <h3>
                                    <i class="fa-solid fa-circle-question" style="color: var(--primary);"></i>
                                    <span>Cara Pembayaran</span>
                                </h3>
                                <div class="step-list">
                                    <div class="step-item">
                                        <div class="step-num">1</div>
                                        <p>Buka aplikasi e-wallet (<strong>GoPay</strong>, <strong>Dana</strong>, <strong>OVO</strong>, <strong>ShopeePay</strong>) atau aplikasi <strong>Mobile Banking</strong> pilihan Anda.</p>
                                    </div>
                                    <div class="step-item">
                                        <div class="step-num">2</div>
                                        <p>Pilih menu <strong>Bayar</strong> / <strong>Scan QRIS</strong> pada layar utama aplikasi.</p>
                                    </div>
                                    <div class="step-item">
                                        <div class="step-num">3</div>
                                        <p>Arahkan kamera ke kode QRIS di atas hingga terdeteksi dengan jelas.</p>
                                    </div>
                                    <div class="step-item">
                                        <div class="step-num">4</div>
                                        <p>Pastikan nama toko <strong><%= storeName %></strong> dan nominal <strong><%= formatRupiah(payment.amount) %></strong> sudah sesuai tanpa selisih.</p>
                                    </div>
                                    <div class="step-item">
                                        <div class="step-num">5</div>
                                        <p>Masukkan PIN transaksi Anda. Halaman ini akan <strong>otomatis berubah</strong> dalam 2 detik setelah pembayaran berhasil.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT COLUMN: ORDER SUMMARY -->
                    <div style="display: flex; flex-direction: column; gap: 24px;">
                        <div class="card">
                            <div class="card-header">
                                <h2>
                                    <i class="fa-solid fa-receipt" style="color: var(--primary);"></i>
                                    <span>Rincian Pembayaran</span>
                                </h2>
                            </div>

                            <div class="summary">
                                <div class="amount-label">Total Pembayaran</div>
                                <div class="amount font-mono"><%= formatRupiah(payment.amount) %></div>
                                <div class="merchant">
                                    Merchant: <strong><%= storeName %></strong>
                                </div>

                                <div class="divider"></div>

                                <div class="detail-row">
                                    <span class="detail-label">Nomor Pesanan</span>
                                    <div style="display: flex; align-items: center; gap: 6px;">
                                        <span class="detail-value font-mono"><%= payment.order_id %></span>
                                        <button class="copy-pill" onclick="copyText('<%= payment.order_id %>', 'Nomor Pesanan')">
                                            <i class="fa-regular fa-copy"></i> Salin
                                        </button>
                                    </div>
                                </div>

                                <div class="detail-row">
                                    <span class="detail-label">ID Tagihan</span>
                                    <span class="detail-value font-mono" style="font-size: 11px;"><%= payment.payment_id.substring(0, 16) %>...</span>
                                </div>

                                <div class="detail-row">
                                    <span class="detail-label">Waktu Dibuat</span>
                                    <span class="detail-value font-mono"><%= payment.created_at ? new Date(payment.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : '-' %></span>
                                </div>

                                <div class="detail-row">
                                    <span class="detail-label">Metode</span>
                                    <span class="detail-value" style="color: var(--primary); font-weight: 800;">QRIS Otomatis</span>
                                </div>

                                <div class="detail-row">
                                    <span class="detail-label">Biaya Transaksi</span>
                                    <span class="detail-value" style="color: var(--success); font-weight: 800;">Rp 0 (Gratis)</span>
                                </div>

                                <div class="divider"></div>

                                <div style="display: flex; align-items: center; justify-content: space-between; font-size: 11.5px; color: var(--muted);">
                                    <span>Pengecekan Otomatis:</span>
                                    <span id="polling-indicator" style="display: flex; align-items: center; gap: 5px; color: var(--success); font-weight: 700;">
                                        <i class="fa-solid fa-circle-notch fa-spin"></i> Aktif (Real-time)
                                    </span>
                                </div>

                                <div style="margin-top: 14px;">
                                    <button onclick="checkStatusManual()" class="btn-action-secondary" style="width: 100%; font-size: 12px; padding: 10px;">
                                        <i class="fa-solid fa-rotate-right" id="manual-refresh-icon"></i> Cek Status Sekarang
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- SECURITY CARD -->
                        <div class="card" style="padding: 16px 20px; background: var(--surface);">
                            <div style="display: flex; align-items: flex-start; gap: 12px;">
                                <i class="fa-solid fa-lock" style="color: var(--primary); font-size: 18px; margin-top: 2px;"></i>
                                <div style="font-size: 11.5px; color: var(--muted); line-height: 1.5;">
                                    Transaksi ini diproses secara aman melalui <strong><%= appName %></strong>. QRIS dilindungi enkripsi standar Bank Indonesia &amp; ASPI.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- DYNAMIC SUCCESS CONTAINER (HIDDEN UNTIL PAYMENT CONFIRMED) -->
            <div id="stage-success" style="display: none;">
                <div class="card" style="max-width: 620px; margin: 20px auto;">
                    <div class="success-hero">
                        <div class="success-icon-wrap">
                            <i class="fa-solid fa-check"></i>
                        </div>
                        <h2>Pembayaran Berhasil!</h2>
                        <p>Terima kasih, pembayaran Anda telah diverifikasi otomatis oleh jaringan QRIS Nasional.</p>
                        <div class="success-amount-pill font-mono">
                            <%= formatRupiah(payment.amount) %>
                        </div>
                    </div>

                    <div class="summary" style="border-top: 1px solid var(--border);">
                        <div class="detail-row">
                            <span class="detail-label">Merchant</span>
                            <span class="detail-value"><%= storeName %></span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Nomor Pesanan</span>
                            <span class="detail-value font-mono"><%= payment.order_id %></span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">ID Transaksi</span>
                            <span class="detail-value font-mono" style="font-size: 11px;"><%= payment.payment_id %></span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Waktu Pembayaran</span>
                            <span class="detail-value font-mono" id="success-time-val">-</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Metode Pembayaran</span>
                            <span class="detail-value" style="color: var(--success); font-weight: 800;">QRIS GO-PAY VERIFIED</span>
                        </div>
                        
                        <div class="divider"></div>

                        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
                            <button onclick="window.print()" class="btn-action-secondary">
                                <i class="fa-solid fa-print"></i> Cetak Bukti Bayar
                            </button>
                            <% if (payment.redirect_url) { %>
                                <a id="btn-redirect-now-dynamic" href="<%= payment.redirect_url %>" class="btn-action-primary">
                                    <span>Lanjutkan</span> <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            <% } %>
                        </div>

                        <% if (payment.redirect_url) { %>
                            <div class="redirect-bar-container">
                                <div style="display: flex; justify-content: space-between; font-size: 11.5px; color: var(--muted); font-weight: 600;">
                                    <span>Mengalihkan otomatis ke website toko...</span>
                                    <span class="font-mono" id="redirect-countdown-dynamic">5s</span>
                                </div>
                                <div class="redirect-bar-track">
                                    <div class="redirect-bar-fill" id="redirect-progress-dynamic"></div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- DYNAMIC EXPIRED CONTAINER -->
            <div id="stage-expired" style="display: none;">
                <div class="card" style="max-width: 600px; margin: 30px auto;">
                    <div class="expired-hero">
                        <div class="expired-icon-wrap">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                        </div>
                        <h2>Waktu Pembayaran Habis</h2>
                        <p>Batas waktu pembayaran untuk transaksi ini telah berakhir. Silakan lakukan pemesanan ulang untuk memperoleh kode QRIS yang baru.</p>
                    </div>

                    <div class="summary" style="border-top: 1px solid var(--border);">
                        <div class="detail-row">
                            <span class="detail-label">Nomor Pesanan</span>
                            <span class="detail-value font-mono"><%= payment.order_id %></span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Total Tagihan</span>
                            <span class="detail-value font-mono" style="color: var(--muted);"><%= formatRupiah(payment.amount) %></span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Status</span>
                            <span class="detail-value" style="color: var(--danger);">KADALUARSA (EXPIRED)</span>
                        </div>

                        <div class="divider"></div>

                        <div style="text-align: center;">
                            <a href="javascript:window.location.reload()" class="btn-action-primary">
                                <i class="fa-solid fa-rotate-right"></i> Muat Ulang Halaman
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </main>

    <!-- FOOTER -->
    <footer class="footer">
        <div>Hak Cipta &copy; <%= new Date().getFullYear() %> <strong><%= appName %></strong> &bull; Merchant: <strong><%= storeName %></strong></div>
        <div>Layanan Otomasi QRIS GoPay &bull; Bank Indonesia &amp; ASPI Standardized</div>
    </footer>

    <!-- TOAST NOTIFICATION -->
    <div class="toast" id="toast">
        <i class="fa-solid fa-circle-check" style="color: #38c994;"></i>
        <span id="toast-msg">Teks berhasil disalin</span>
    </div>

    <!-- SOUND & CHIME AUDIO (WEB AUDIO SYNTHESIZER) -->
    <script>
        function playSuccessSound() {
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                const ctx = new AudioCtx();
                
                const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
                notes.forEach((freq, i) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, ctx.currentTime + (i * 0.12));
                    gain.gain.setValueAtTime(0.2, ctx.currentTime + (i * 0.12));
                    gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + (i * 0.12) + 0.35);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start(ctx.currentTime + (i * 0.12));
                    osc.stop(ctx.currentTime + (i * 0.12) + 0.4);
                });
            } catch (e) {
                console.warn('Audio playback not allowed or not supported:', e);
            }
        }
    </script>

    <!-- CLIENT SCRIPT -->
    <script>
        // Data from Server
        const paymentId = "<%= payment ? payment.payment_id : '' %>";
        const orderId = "<%= payment ? payment.order_id : '' %>";
        const rawQrisCode = "<%- payment && payment.qris_code ? payment.qris_code : '' %>";
        const rawQrImage = "<%- payment && payment.qr_image ? payment.qr_image : '' %>";
        const expiresTimestamp = <%= payment && payment.expires_timestamp ? payment.expires_timestamp : 0 %>;
        const redirectUrl = "<%= payment && payment.redirect_url ? payment.redirect_url : '' %>";
        const totalAmount = <%= payment ? payment.amount : 0 %>;
        let isPaid = <%= payment && payment.status === 'PAID' ? 'true' : 'false' %>;

        let pollInterval = null;
        let countdownTimer = null;

        // Theme management
        function initTheme() {
            const savedTheme = localStorage.getItem('yuripay_theme') || 
                (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            applyTheme(savedTheme);
        }

        function applyTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            const icon = document.getElementById('theme-icon');
            if (icon) {
                if (theme === 'dark') {
                    icon.classList.remove('fa-moon');
                    icon.classList.add('fa-sun');
                } else {
                    icon.classList.remove('fa-sun');
                    icon.classList.add('fa-moon');
                }
            }
            localStorage.setItem('yuripay_theme', theme);
        }

        function toggleTheme() {
            const current = document.documentElement.getAttribute('data-theme') || 'light';
            applyTheme(current === 'dark' ? 'light' : 'dark');
        }

        // Toast feedback
        function showToast(msg) {
            const toast = document.getElementById('toast');
            const msgEl = document.getElementById('toast-msg');
            if (toast && msgEl) {
                msgEl.innerText = msg;
                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 2200);
            }
        }

        // Copy text helper
        function copyText(val, label) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(val).then(() => {
                    showToast(label + ' berhasil disalin!');
                }).catch(() => {
                    fallbackCopy(val, label);
                });
            } else {
                fallbackCopy(val, label);
            }
        }

        function fallbackCopy(val, label) {
            const ta = document.createElement('textarea');
            ta.value = val;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try {
                document.execCommand('copy');
                showToast(label + ' berhasil disalin!');
            } catch (e) {
                showToast('Gagal menyalin');
            }
            document.body.removeChild(ta);
        }

        // Render QR Code
        function renderQrCode() {
            const qrContainer = document.getElementById('qrcode');
            if (!qrContainer) return;
            qrContainer.innerHTML = '';

            const qrData = rawQrisCode || rawQrImage;
            if (!qrData) {
                qrContainer.innerHTML = '<div style="color:var(--muted); font-size:12px; padding:20px;">Memuat kode QR...</div>';
                return;
            }

            // If qrData starts with data:image or is http url
            if (qrData.startsWith('data:image') || qrData.startsWith('http://') || qrData.startsWith('https://')) {
                const img = document.createElement('img');
                img.src = qrData;
                img.alt = 'QRIS Code';
                qrContainer.appendChild(img);
            } else {
                // Generate QR with QRCode.js
                try {
                    new QRCode(qrContainer, {
                        text: qrData,
                        width: 248,
                        height: 248,
                        colorDark: "#000000",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.M
                    });
                } catch (e) {
                    console.error('QRCode rendering error:', e);
                    const img = document.createElement('img');
                    img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=' + encodeURIComponent(qrData);
                    img.alt = 'QRIS Code';
                    qrContainer.appendChild(img);
                }
            }
        }

        // Countdown Timer
        function startCountdown() {
            const display = document.getElementById('countdown-display');
            if (!display || !expiresTimestamp) return;

            function update() {
                const now = Date.now();
                const diff = Math.floor((expiresTimestamp - now) / 1000);

                if (diff <= 0) {
                    display.innerText = '00:00';
                    if (countdownTimer) clearInterval(countdownTimer);
                    if (pollInterval) clearInterval(pollInterval);
                    handleExpired();
                    return;
                }

                const mins = Math.floor(diff / 60);
                const secs = diff % 60;
                display.innerText = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
            }

            update();
            countdownTimer = setInterval(update, 1000);
        }

        // Polling payment status
        function startPolling() {
            if (!paymentId || isPaid) return;

            pollInterval = setInterval(async () => {
                await checkStatus(false);
            }, 2500);
        }

        async function checkStatus(isManual = false) {
            if (isPaid || !paymentId) return;

            const refreshIcon = document.getElementById('manual-refresh-icon');
            if (isManual && refreshIcon) refreshIcon.classList.add('fa-spin');

            try {
                const res = await fetch('/api/payment-status/' + encodeURIComponent(paymentId), {
                    headers: { 'Accept': 'application/json' }
                });
                if (!res.ok) throw new Error('Network error ' + res.status);
                const data = await res.json();

                if (data.status === 'PAID') {
                    handleSuccess(data);
                } else if (data.status === 'EXPIRED') {
                    handleExpired();
                } else if (isManual) {
                    showToast('Status: Masih menunggu pembayaran');
                }
            } catch (err) {
                if (isManual) showToast('Gagal memeriksa status');
            } finally {
                if (isManual && refreshIcon) refreshIcon.classList.remove('fa-spin');
            }
        }

        function checkStatusManual() {
            checkStatus(true);
        }

        // Confetti burst
        function fireConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 80,
                    spread: 70,
                    origin: { y: 0.6 }
                });
                setTimeout(() => {
                    confetti({
                        particleCount: 50,
                        angle: 60,
                        spread: 55,
                        origin: { x: 0 }
                    });
                    confetti({
                        particleCount: 50,
                        angle: 120,
                        spread: 55,
                        origin: { x: 1 }
                    });
                }, 250);
            }
        }

        // Transition to Success View
        function handleSuccess(data) {
            isPaid = true;
            if (pollInterval) clearInterval(pollInterval);
            if (countdownTimer) clearInterval(countdownTimer);

            // Audio & Confetti
            playSuccessSound();
            fireConfetti();

            // Swap views
            const stagePending = document.getElementById('stage-pending');
            const stageSuccess = document.getElementById('stage-success');
            if (stagePending) stagePending.style.display = 'none';
            if (stageSuccess) stageSuccess.style.display = 'block';

            const timeVal = document.getElementById('success-time-val');
            if (timeVal) {
                timeVal.innerText = new Date().toLocaleString('id-ID');
            }

            // Handle redirect if configured
            if (redirectUrl) {
                let targetUrl = redirectUrl;
                try {
                    const u = new URL(targetUrl, window.location.origin);
                    u.searchParams.set('order_id', orderId);
                    u.searchParams.set('payment_id', paymentId);
                    u.searchParams.set('status', 'PAID');
                    u.searchParams.set('amount', totalAmount);
                    targetUrl = u.toString();
                } catch (e) {}

                const btnRedir = document.getElementById('btn-redirect-now-dynamic');
                if (btnRedir) btnRedir.href = targetUrl;

                let timeLeft = 5;
                const cdEl = document.getElementById('redirect-countdown-dynamic');
                const barEl = document.getElementById('redirect-progress-dynamic');

                const redirTimer = setInterval(() => {
                    timeLeft--;
                    if (cdEl) cdEl.innerText = timeLeft + 's';
                    if (barEl) barEl.style.width = ((timeLeft / 5) * 100) + '%';
                    if (timeLeft <= 0) {
                        clearInterval(redirTimer);
                        window.location.href = targetUrl;
                    }
                }, 1000);
            }
        }

        // Transition to Expired View
        function handleExpired() {
            if (pollInterval) clearInterval(pollInterval);
            if (countdownTimer) clearInterval(countdownTimer);

            const stagePending = document.getElementById('stage-pending');
            const stageExpired = document.getElementById('stage-expired');
            if (stagePending) stagePending.style.display = 'none';
            if (stageExpired) stageExpired.style.display = 'block';
        }

        // Direct SSR Success handling (confetti & redirect on page reload)
        function handleDirectSsrSuccess() {
            fireConfetti();
            if (redirectUrl) {
                let timeLeft = 5;
                const cdEl = document.getElementById('redirect-countdown');
                const barEl = document.getElementById('redirect-progress');
                if (cdEl && barEl) {
                    const rTimer = setInterval(() => {
                        timeLeft--;
                        cdEl.innerText = timeLeft + 's';
                        barEl.style.width = ((timeLeft / 5) * 100) + '%';
                        if (timeLeft <= 0) {
                            clearInterval(rTimer);
                            window.location.href = redirectUrl;
                        }
                    }, 1000);
                }
            }
        }

        // Init on DOM Ready
        window.addEventListener('DOMContentLoaded', () => {
            initTheme();

            if (isPaid) {
                handleDirectSsrSuccess();
            } else if (paymentId) {
                renderQrCode();
                startCountdown();
                startPolling();
            }
        });
    </script>
</body>
</html>
