                                </div>
                                <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/80 text-emerald-600 font-extrabold">Auto</span>
                            </div>

                            <div id="overview-mutations-list" class="space-y-2.5 max-h-64 overflow-y-auto pr-1">
                                <div class="text-center py-8 text-xs text-slate-400">
                                    <i class="fa-solid fa-circle-notch fa-spin text-base mb-2"></i>
                                    <p>Mengambil data mutasi GoPay terkini...</p>
                                </div>
                            </div>
                        </div>

                        <div class="pt-3 border-t border-slate-100 dark:border-fintech-darkBorder/60 flex items-center justify-between text-xs">
                            <span class="text-slate-400">Provider: ASPI QRIS / GoPay</span>
                            <button onclick="switchView('financial')" class="font-bold text-fintech-blue hover:underline">
                                Buka Rekap Keuangan &rarr;
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Recent Transactions Quick Preview -->
