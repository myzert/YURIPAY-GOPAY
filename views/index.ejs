                            </thead>
                            <tbody id="overview-recent-tbody" class="divide-y divide-slate-100 dark:divide-fintech-darkBorder/60 font-medium">
                                <!-- Populated dynamically by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

