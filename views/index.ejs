    <!-- ========================================================= -->
    <!-- 4. FRONTEND CORE CLIENT JAVASCRIPT LOGIC                  -->
    <!-- ========================================================= -->
    <script>
        // State variables
        let currentSection = '<%= typeof activeSection !== "undefined" ? activeSection : "overview" %>';
        let txSearchDebounce = null;
        let logSearchDebounce = null;
        let activePosPaymentId = null;
        let posPollInterval = null;
        let posCountdownInterval = null;
        let currentLogCategory = 'ALL';

        const arigatoLocal = document.getElementById('soundbox-audio-local');
        const arigatoOnline = document.getElementById('soundbox-audio-online');

        // Initial Data from Server
        const INITIAL_PAYMENTS = <%- JSON.stringify(recentPayments || []) %>;
        const INITIAL_STATS = <%- JSON.stringify(stats || {}) %>;

        // --- Theme Engine ---
        function initTheme() {
            const saved = localStorage.getItem('yuripay_theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (saved === 'dark' || (!saved && prefersDark)) {
                document.documentElement.classList.add('dark');
                document.getElementById('theme-icon').className = 'fa-solid fa-sun';
            } else {
                document.documentElement.classList.remove('dark');
                document.getElementById('theme-icon').className = 'fa-solid fa-moon';
            }
        }

        function toggleDarkMode() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('yuripay_theme', isDark ? 'dark' : 'light');
            document.getElementById('theme-icon').className = isDark ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
        }

        // --- Mobile Sidebar Drawer ---
        function toggleSidebar(open) {
            const sidebar = document.getElementById('sidebar-container');
            const backdrop = document.getElementById('sidebar-backdrop');
            if (open) {
                sidebar.classList.remove('-translate-x-full');
                backdrop.classList.remove('hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                backdrop.classList.add('hidden');
            }
        }

        // --- View Routing & Active State ---
        function switchView(sectionId, updateHistory = true) {
            currentSection = sectionId;

            // Hide all sections
            document.querySelectorAll('.view-section').forEach(el => el.classList.add('hidden'));

            // Show selected section
            const targetSection = document.getElementById('section-' + sectionId);
            if (targetSection) targetSection.classList.remove('hidden');

            // Update sidebar buttons
            document.querySelectorAll('.nav-item').forEach(btn => {
                btn.classList.remove('bg-fintech-blue', 'text-white', 'shadow-md', 'shadow-blue-500/20');
                btn.classList.add('text-slate-600', 'dark:text-slate-300');
                const icon = btn.querySelector('.nav-icon');
                if (icon) icon.classList.remove('text-white');
            });

            const activeBtn = document.getElementById('nav-' + sectionId);
            if (activeBtn) {
                activeBtn.classList.add('bg-fintech-blue', 'text-white', 'shadow-md', 'shadow-blue-500/20');
                activeBtn.classList.remove('text-slate-600', 'dark:text-slate-300');
                const icon = activeBtn.querySelector('.nav-icon');
                if (icon) icon.classList.add('text-white');
            }

            // Update Breadcrumb & Page Titles
            const titles = {
                overview: { title: 'Ringkasan Keuangan & Gateway', breadcrumb: 'Ringkasan Dashboard' },
                transactions: { title: 'Manajemen Transaksi QRIS', breadcrumb: 'Transaksi' },
                financial: { title: 'Laporan Keuangan & Settlement', breadcrumb: 'Keuangan' },
                pos: { title: 'Kasir POS & Dynamic QR', breadcrumb: 'Kasir POS' },
                logs: { title: 'Pusat Log & Audit Trail', breadcrumb: 'Pusat Log' },
                developer: { title: 'Sandbox API & Kredensial', breadcrumb: 'Developer API' },
                security: { title: 'Keamanan Akun & Kredensial Admin', breadcrumb: 'Keamanan' }
            };

            const meta = titles[sectionId] || { title: 'Dashboard', breadcrumb: 'Dashboard' };
            document.getElementById('page-title').innerText = meta.title;
            document.getElementById('breadcrumb-current').innerText = meta.breadcrumb;

            // Close mobile sidebar if open
            toggleSidebar(false);

            // Trigger lazy loading per view
            if (sectionId === 'transactions') {
                fetchTransactions(1);
            } else if (sectionId === 'financial') {
                loadFinancialSummary();
                loadFinancialSettlements();
            } else if (sectionId === 'logs') {
                fetchSystemLogs();
            } else if (sectionId === 'developer') {
                switchCodeTab('curl');
            }

            // Sync with browser URL cleanly without page reload
            if (updateHistory) {
                const targetPath = sectionId === 'overview' ? '/' : '/' + sectionId;
                if (window.location.pathname !== targetPath) {
                    window.history.pushState({ section: sectionId }, '', targetPath);
                }
            }
        }

        // Support browser Back/Forward navigation
        window.addEventListener('popstate', (e) => {
            const sec = e.state?.section || (window.location.pathname.replace('/', '') || 'overview');
            switchView(sec, false);
        });

        // --- Toast Notification System ---
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            const icons = {
                success: 'fa-solid fa-circle-check text-emerald-500',
                error: 'fa-solid fa-circle-exclamation text-rose-500',
                info: 'fa-solid fa-circle-info text-sky-500'
            };
            const bgClasses = {
                success: 'bg-white dark:bg-fintech-darkCard border-emerald-500/40 text-slate-800 dark:text-slate-100',
                error: 'bg-white dark:bg-fintech-darkCard border-rose-500/40 text-slate-800 dark:text-slate-100',
                info: 'bg-white dark:bg-fintech-darkCard border-sky-500/40 text-slate-800 dark:text-slate-100'
            };

            toast.className = `p-3.5 rounded-2xl shadow-xl border flex items-center gap-3 text-xs font-semibold animate-fade-in pointer-events-auto transition-all ${bgClasses[type] || bgClasses.info}`;
            toast.innerHTML = `
                <i class="${icons[type] || icons.info} text-base shrink-0"></i>
                <span class="flex-1">${message}</span>
            `;

            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-10px)';
                setTimeout(() => toast.remove(), 250);
            }, 3500);
        }

        // Copy Helper
        function copyToClipboard(text, successMsg = 'Tersalin ke clipboard!') {
            if (!text) return;
            navigator.clipboard.writeText(text).then(() => {
                showToast(successMsg, 'success');
            }).catch(() => {
                showToast('Gagal menyalin otomatis', 'error');
            });
        }

        // Formatting Helpers
        function formatRupiah(num) {
            return 'Rp ' + Number(num || 0).toLocaleString('id-ID');
        }

        function formatDate(dateStr) {
            if (!dateStr) return '-';
            const d = new Date(dateStr);
            if (isNaN(d.getTime())) return '-';
            return d.toLocaleString('id-ID', {
                day: '2-digit',
                month: 'short',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        // Soundbox Voice Player
        function playSoundbox() {
            arigatoLocal.currentTime = 0;
            arigatoLocal.play().catch(() => {
                arigatoOnline.currentTime = 0;
                arigatoOnline.play().catch(e => console.warn('Audio play error:', e));
            });
        }

        function launchConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 90,
                    spread: 80,
                    origin: { y: 0.6 }
                });
            }
        }

        function testSoundboxVoice() {
            playSoundbox();
            launchConfetti();
            document.getElementById('celebration-amount').innerText = formatRupiah(50000);
            document.getElementById('celebration-modal').classList.remove('hidden');
        }

        function closeCelebrationModal() {
            document.getElementById('celebration-modal').classList.add('hidden');
        }

        // --- Render Overview Recent Table & Mutations ---
        function renderOverviewRecent(payments) {
            const tbody = document.getElementById('overview-recent-tbody');
            if (!tbody) return;
            const slice = (payments || []).slice(0, 5);
            if (slice.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-6 text-slate-400">Belum ada transaksi tercatat</td></tr>`;
                return;
            }

            tbody.innerHTML = slice.map(p => {
                const isPaid = (p.status || '').toUpperCase() === 'PAID';
                const isPending = (p.status || '').toUpperCase() === 'PENDING';
                const statusBadge = isPaid 
                    ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300">PAID</span>`
                    : (isPending 
                        ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300">PENDING</span>`
                        : `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-500">EXPIRED</span>`);

                return `
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition">
                        <td class="py-3 px-3 font-mono font-bold text-slate-800 dark:text-slate-200">${p.order_id || p.orderId || p.id.substring(0, 8)}</td>
                        <td class="py-3 px-3 text-slate-600 dark:text-slate-400 truncate max-w-[150px]">${p.custom_name || p.customName || 'Pesanan'}</td>
                        <td class="py-3 px-3 font-mono font-extrabold text-slate-900 dark:text-white">${formatRupiah(p.total_amount || p.totalAmount)}</td>
                        <td class="py-3 px-3">${statusBadge}</td>
                        <td class="py-3 px-3 font-mono text-[11px] text-slate-400">${formatDate(p.created_at || p.createdAt)}</td>
                        <td class="py-3 px-3 text-right">
                            <button onclick="openTransactionDrawer('${p.id}')" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-[11px] font-bold text-fintech-blue hover:bg-slate-200 transition">
                                Detail
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Fetch Live GoPay Mutations for Overview & Financial
        async function fetchLiveMutations() {
            try {
                const res = await fetch('/api/recent-mutations');
                const data = await res.json();
                const container = document.getElementById('overview-mutations-list');
                const finTbody = document.getElementById('settlement-table-tbody');

                if (data.success && Array.isArray(data.mutations) && data.mutations.length > 0) {
                    if (container) {
                        container.innerHTML = data.mutations.map(m => `
                            <div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-fintech-darkBorder flex items-center justify-between">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-xl bg-emerald-100 dark:bg-emerald-950/70 text-emerald-600 flex items-center justify-center text-xs font-bold shrink-0">
                                        <i class="fa-solid fa-arrow-down"></i>
                                    </div>
                                    <div>
                                        <p class="font-mono font-bold text-xs text-slate-900 dark:text-white">${formatRupiah(m.amount)}</p>
                                        <p class="text-[10px] text-slate-400 font-mono">${m.issuer} • ${m.time ? m.time.substring(11, 16) : ''}</p>
                                    </div>
                                </div>
                                <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-50 dark:bg-emerald-950 text-emerald-600 border border-emerald-200 dark:border-emerald-800">
                                    ${m.status}
                                </span>
                            </div>
                        `).join('');
                    }

                    if (finTbody) {
                        finTbody.innerHTML = data.mutations.map(m => `
                            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
