        // --- Financial Summary & Chart Loader ---
        async function loadFinancialSummary() {
            try {
                const res = await fetch('/api/financial/summary');
                const data = await res.json();
                if (!data.success) return;
                const s = data.summary;

                // Update Overview numbers
                document.getElementById('summary-net-profit').innerText = formatRupiah(s.netProfit);
                
                // Update Financial Section Cards
                const finGross = document.getElementById('fin-gross-income');
                const finExpenses = document.getElementById('fin-expenses');
                const finNet = document.getElementById('fin-net-profit');
                const finAvg = document.getElementById('fin-avg-transaction');

                if (finGross) finGross.innerText = formatRupiah(s.allVolume);
                if (finExpenses) finExpenses.innerText = formatRupiah(s.expenses);
                if (finNet) finNet.innerText = formatRupiah(s.netProfit);
                if (finAvg) finAvg.innerText = formatRupiah(s.avgTransaction);

                // Render Chart Bars
                const chartBox = document.getElementById('chart-bars-container');
                if (chartBox && Array.isArray(s.chartData)) {
                    const maxVol = Math.max(...s.chartData.map(d => d.volume), 100000);
                    chartBox.innerHTML = s.chartData.map(item => {
                        const pct = Math.max(8, Math.min(100, Math.round((item.volume / maxVol) * 100)));
                        return `
                            <div class="flex-1 flex flex-col items-center gap-1.5 h-full justify-end group">
                                <span class="text-[9px] font-mono font-bold text-slate-400 group-hover:text-emerald-500 transition">${item.volume > 0 ? (item.volume >= 1000000 ? (item.volume/1000000).toFixed(1)+'M' : (item.volume/1000).toFixed(0)+'k') : '0'}</span>
                                <div class="w-full max-w-[36px] bg-emerald-500/80 group-hover:bg-emerald-500 rounded-t-xl transition-all duration-300 shadow-sm" style="height: ${pct}%;"></div>
                                <span class="text-[10px] font-semibold text-slate-500 dark:text-slate-400 truncate max-w-[48px]">${item.label}</span>
                            </div>
                        `;
                    }).join('');
                }
            } catch (e) {
                console.warn('Summary fetch error:', e.message);
            }
        }

