                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="switchView('pos')"
                                class="px-4 py-2.5 rounded-2xl bg-fintech-blue hover:bg-fintech-blueHover text-white text-xs font-extrabold shadow-md shadow-blue-500/20 transition flex items-center gap-2">
