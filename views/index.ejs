                        <button type="button" onclick="setLogCategory('PAYMENT')" id="log-cat-PAYMENT" class="log-cat-btn px-3 py-1.5 rounded-xl font-bold transition bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">Pembayaran</button>
                        <button type="button" onclick="setLogCategory('WEBHOOK')" id="log-cat-WEBHOOK" class="log-cat-btn px-3 py-1.5 rounded-xl font-bold transition bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">Webhook</button>
                        <button type="button" onclick="setLogCategory('AUTH')" id="log-cat-AUTH" class="log-cat-btn px-3 py-1.5 rounded-xl font-bold transition bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">Autentikasi</button>
                        <button type="button" onclick="setLogCategory('ACTIVITY')" id="log-cat-ACTIVITY" class="log-cat-btn px-3 py-1.5 rounded-xl font-bold transition bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">Aktivitas Admin</button>
                        <button type="button" onclick="setLogCategory('SYSTEM')" id="log-cat-SYSTEM" class="log-cat-btn px-3 py-1.5 rounded-xl font-bold transition bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">Sistem</button>
                        <button type="button" onclick="setLogCategory('ERROR')" id="log-cat-ERROR" class="log-cat-btn px-3 py-1.5 rounded-xl font-bold transition bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">Error</button>
                    </div>

                    <!-- Search & Severity Filter Bar -->
