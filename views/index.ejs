            };

            document.getElementById('code-snippet-box').innerText = snippets[tab] || snippets.curl;
        }

        function copySnippetCode() {
            copyToClipboard(document.getElementById('code-snippet-box').innerText, 'Snippet kode tersalin!');
        }

        function toggleSecretVisibility() {
            const input = document.getElementById('dev-secret-key');
            const icon = document.getElementById('secret-eye-icon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fa-solid fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fa-solid fa-eye';
            }
        }

        async function regenerateApiKeysConfirm() {
            if (!confirm('Peringatan: Membuat kunci API baru akan membatalkan kunci lama. Lanjutkan?')) return;
            try {
                const res = await fetch('/api/keys/regenerate', { method: 'POST' });
                const data = await res.json();
                if (data.success && data.data) {
                    document.getElementById('dev-public-key').value = data.data.publicKey;
                    document.getElementById('dev-secret-key').value = data.data.secretKey;
                    showToast('Kunci API baru berhasil dibuat!', 'success');
                } else {
                    showToast('Gagal regenerate kunci: ' + data.message, 'error');
                }
            } catch (e) {
                showToast('Error: ' + e.message, 'error');
            }
        }

        async function dispatchTestWebhook() {
            const url = document.getElementById('test-webhook-url').value.trim();
            if (!url) {
                showToast('Masukkan URL webhook valid', 'error');
                return;
            }
            try {
                showToast('Mengirim webhook tes...', 'info');
                const res = await fetch('/api/test-webhook-dispatch', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ webhook_url: url, amount: 50000 })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || 'Webhook berhasil dikirim!', 'success');
                } else {
                    showToast(data.message || 'Gagal mengirim webhook', 'error');
                }
            } catch (e) {
                showToast('Error: ' + e.message, 'error');
            }
        }

        // --- Store Name / Merchant Branding Change ---
        async function handleStoreNameChange(e) {
            e.preventDefault();
            const storeNameInput = document.getElementById('input-store-name');
            const newName = storeNameInput ? storeNameInput.value.trim() : '';
            if (!newName) {
                showToast('Nama toko tidak boleh kosong!', 'error');
                return;
            }
            const btn = document.getElementById('btn-save-store-name');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> <span>Menyimpan...</span>';
            }
            try {
                const res = await fetch('/api/admin/store-name', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ store_name: newName })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || 'Nama toko berhasil diperbarui!', 'success');
                    const badge = document.getElementById('active-store-name-badge');
                    if (badge) badge.innerText = data.store_name;
                    const sidebarName = document.getElementById('sidebar-store-name');
                    if (sidebarName) sidebarName.innerText = data.store_name + ' Console';
                } else {
                    showToast(data.message || 'Gagal mengubah nama toko', 'error');
                }
            } catch (err) {
                showToast('Error: ' + err.message, 'error');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> <span>Simpan Nama Toko</span>';
                }
            }
        }

        // --- Security & Admin Credentials Change ---
        async function handleCredentialsChange(e) {
            e.preventDefault();
            const curPwd = document.getElementById('cred-cur-pwd').value;
            const newEmail = document.getElementById('cred-new-email').value;
            const newPwd = document.getElementById('cred-new-pwd').value;
            const confPwd = document.getElementById('cred-confirm-pwd').value;

            if (newPwd && newPwd !== confPwd) {
                showToast('Konfirmasi kata sandi tidak cocok!', 'error');
                return;
            }

            try {
                const res = await fetch('/api/admin/change-credentials', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        current_password: curPwd,
                        new_email: newEmail || undefined,
                        new_password: newPwd || undefined,
                        confirm_password: confPwd || undefined
                    })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || 'Kredensial berhasil diperbarui!', 'success');
                    document.getElementById('form-change-creds').reset();
                } else {
                    showToast(data.message || 'Gagal mengubah kredensial', 'error');
                }
            } catch (err) {
                showToast('Error: ' + err.message, 'error');
            }
        }

        // --- Global Realtime Refresh ---
        async function refreshDashboardData() {
            const icon = document.getElementById('sync-icon');
            if (icon) icon.classList.add('fa-spin');

            try {
                const res = await fetch('/api/dashboard-data');
                const data = await res.json();
                if (data.success && data.stats) {
                    const s = data.stats;
                    document.getElementById('stat-today-volume').innerText = formatRupiah(s.todayVolume);
                    document.getElementById('stat-all-volume').innerText = formatRupiah(s.allVolume);
                    document.getElementById('stat-today-success').innerHTML = `${s.todaySuccess} <span class="text-xs font-normal text-slate-400">/ ${s.todayTotal} trx</span>`;
                    document.getElementById('stat-success-rate').innerText = `${s.successRate}%`;
                    document.getElementById('stat-today-pending').innerText = s.todayPending;
                    document.getElementById('stat-all-pending').innerText = s.allPending;
                    document.getElementById('stat-today-expired').innerText = s.todayExpired || 0;
                    document.getElementById('stat-all-expired').innerText = s.allExpired || 0;
                    document.getElementById('badge-total-trx').innerText = s.allTotal;
                    document.getElementById('traffic-total-label').innerText = `Total ${s.allTotal} Transaksi Keseluruhan`;

                    if (s.allTotal > 0) {
                        document.getElementById('bar-success').style.width = `${(s.allSuccess / s.allTotal) * 100}%`;
                        document.getElementById('bar-pending').style.width = `${(s.allPending / s.allTotal) * 100}%`;
                        document.getElementById('bar-expired').style.width = `${(s.allExpired / s.allTotal) * 100}%`;
                    }
                    document.getElementById('legend-success').innerText = s.allSuccess;
                    document.getElementById('legend-pending').innerText = s.allPending;
                    document.getElementById('legend-expired').innerText = s.allExpired;

                    if (Array.isArray(data.recent)) {
                        renderOverviewRecent(data.recent);
                    }
                }

                await fetchLiveMutations();
            } catch (e) {
                console.warn('Dashboard sync error:', e);
            } finally {
                setTimeout(() => {
                    if (icon) icon.classList.remove('fa-spin');
                }, 500);
            }
        }

        // Auto-refresh loop every 12 seconds
        setInterval(() => {
            if (currentSection === 'overview') {
                refreshDashboardData();
            }
        }, 12000);

        // --- Init on DOM Ready ---
        document.addEventListener('DOMContentLoaded', () => {
            initTheme();
            renderOverviewRecent(INITIAL_PAYMENTS);
            fetchLiveMutations();
            loadFinancialSummary();
            
            // Activate view based on server path
            const initialSec = '<%= typeof activeSection !== "undefined" ? activeSection : "overview" %>';
            switchView(initialSec, false);
        });
    </script>

</body>
</html>
