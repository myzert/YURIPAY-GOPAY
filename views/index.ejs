                    </div>

                    <!-- 2. Biaya Transaksi / MDR (Expenses) -->
                    <div class="bg-white dark:bg-fintech-darkCard rounded-3xl p-5 border border-slate-200 dark:border-fintech-darkBorder shadow-sm space-y-1">
                        <div class="flex items-center justify-between text-xs text-slate-400 font-bold uppercase tracking-wider">
                            <span>Biaya Layanan (MDR 0%)</span>
                            <i class="fa-solid fa-percent text-sky-500 text-base"></i>
                        </div>
                        <h3 id="fin-expenses" class="text-2xl font-black font-mono text-slate-700 dark:text-slate-300">
                            Rp 0
                        </h3>
                        <p class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold">Tier ASPI QRIS Bebas Potongan</p>
                    </div>

