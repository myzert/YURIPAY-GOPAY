                                <i class="fa-solid fa-floppy-disk"></i>
                                <span>Simpan Nama Toko</span>
                            </button>
                        </form>
                    </div>

                    <!-- Left: Change Admin Credentials Form (7 Cols) -->
                    <div class="lg:col-span-7 bg-white dark:bg-fintech-darkCard rounded-3xl p-6 sm:p-7 border border-slate-200 dark:border-fintech-darkBorder shadow-sm space-y-5">
                        <div>
                            <h3 class="text-base font-black text-slate-900 dark:text-white flex items-center gap-2">
                                <i class="fa-solid fa-user-lock text-rose-500"></i>
                                <span>Kelola Kredensial Admin</span>
