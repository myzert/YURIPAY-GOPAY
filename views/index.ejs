                    <a href="/api/financial/export-csv"
                        class="px-4 py-2.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-extrabold shadow-md shadow-emerald-500/20 transition flex items-center gap-2 self-start sm:self-auto">
