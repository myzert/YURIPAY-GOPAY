        async function fetchTransactions(page = 1) {
            const tbody = document.getElementById('tx-table-tbody');
            if (!tbody) return;

            // Loading skeleton state
            tbody.innerHTML = Array(5).fill(0).map(() => `
                <tr class="animate-pulse">
                    <td class="py-3 px-4"><div class="h-3.5 bg-slate-200 dark:bg-slate-800 rounded w-24"></div></td>
                    <td class="py-3 px-4"><div class="h-3.5 bg-slate-200 dark:bg-slate-800 rounded w-36"></div></td>
                    <td class="py-3 px-4"><div class="h-3.5 bg-slate-200 dark:bg-slate-800 rounded w-20"></div></td>
                    <td class="py-3 px-4"><div class="h-3.5 bg-slate-200 dark:bg-slate-800 rounded w-16"></div></td>
                    <td class="py-3 px-4"><div class="h-3.5 bg-slate-200 dark:bg-slate-800 rounded w-24"></div></td>
                    <td class="py-3 px-4"><div class="h-3.5 bg-slate-200 dark:bg-slate-800 rounded w-24"></div></td>
                    <td class="py-3 px-4 text-right"><div class="h-3.5 bg-slate-200 dark:bg-slate-800 rounded w-12 ml-auto"></div></td>
                </tr>
            `).join('');

            const search = document.getElementById('tx-search-input')?.value || '';
            const status = document.getElementById('tx-status-select')?.value || 'ALL';
            const sortVal = document.getElementById('tx-sort-select')?.value || 'created_at-desc';
            const [sortBy, sortOrder] = sortVal.split('-');

            try {
                const params = new URLSearchParams({
                    page,
                    limit: 15,
                    search,
                    status,
                    sortBy,
                    sortOrder
                });

                const res = await fetch(`/api/transactions?${params.toString()}`);
                const data = await res.json();

                if (!data.success || !Array.isArray(data.transactions) || data.transactions.length === 0) {
                    // Empty state
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="7" class="text-center py-12">
                                <div class="max-w-xs mx-auto space-y-2">
                                    <div class="w-12 h-12 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center text-xl mx-auto">
                                        <i class="fa-solid fa-folder-open"></i>
                                    </div>
                                    <p class="font-extrabold text-sm text-slate-700 dark:text-slate-300">Tidak ada transaksi ditemukan</p>
                                    <p class="text-xs text-slate-400">Coba ubah kata kunci pencarian atau ganti filter status di atas.</p>
                                </div>
                            </td>
                        </tr>
                    `;
                    document.getElementById('tx-pagination-info').innerText = 'Menampilkan 0 transaksi';
                    document.getElementById('tx-pagination-buttons').innerHTML = '';
                    return;
                }

                // Render rows
                tbody.innerHTML = data.transactions.map(p => {
                    const isPaid = (p.status || '').toUpperCase() === 'PAID';
                    const isPending = (p.status || '').toUpperCase() === 'PENDING';
                    const statusBadge = isPaid 
                        ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300"><i class="fa-solid fa-check text-[9px]"></i> PAID</span>`
                        : (isPending 
                            ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300"><i class="fa-solid fa-clock text-[9px]"></i> PENDING</span>`
                            : `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-500"><i class="fa-solid fa-xmark text-[9px]"></i> EXPIRED</span>`);

                    return `
                        <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition">
                            <td class="py-3 px-4">
                                <p class="font-mono font-bold text-slate-900 dark:text-white">${p.order_id || p.orderId || p.id.substring(0, 8)}</p>
                                <p class="font-mono text-[10px] text-slate-400 truncate max-w-[120px]">${p.id}</p>
                            </td>
                            <td class="py-3 px-4 text-slate-700 dark:text-slate-300 truncate max-w-[180px]">${p.custom_name || p.customName || '-'}</td>
                            <td class="py-3 px-4 font-mono font-black text-slate-900 dark:text-white">${formatRupiah(p.total_amount || p.totalAmount)}</td>
                            <td class="py-3 px-4">${statusBadge}</td>
                            <td class="py-3 px-4 font-mono text-[11px] text-slate-500">${formatDate(p.created_at || p.createdAt)}</td>
                            <td class="py-3 px-4 font-mono text-[11px] ${isPaid ? 'text-emerald-600 font-bold' : 'text-slate-400'}">${p.paid_at || p.paidAt ? formatDate(p.paid_at || p.paidAt) : '-'}</td>
                            <td class="py-3 px-4 text-right">
                                <div class="flex items-center justify-end gap-1.5">
                                    <button onclick="openTransactionDrawer('${p.id}')"
                                        class="px-2.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-700 dark:text-slate-200 font-bold transition">
                                        <i class="fa-solid fa-eye mr-1"></i> Detail
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                }).join('');

                // Render pagination
                document.getElementById('tx-pagination-info').innerText = `Menampilkan ${((data.page - 1) * data.limit) + 1} - ${Math.min(data.page * data.limit, data.total)} dari ${data.total} transaksi`;
                
                const pBox = document.getElementById('tx-pagination-buttons');
                pBox.innerHTML = `
                    <button onclick="fetchTransactions(${data.page - 1})" ${data.page <= 1 ? 'disabled class="opacity-40 cursor-not-allowed"' : ''}
                        class="px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-xs font-bold transition">
                        Sebelumnya
                    </button>
                    <span class="px-3 py-1.5 text-xs font-mono font-bold text-slate-600 dark:text-slate-400">${data.page} / ${data.totalPages}</span>
                    <button onclick="fetchTransactions(${data.page + 1})" ${data.page >= data.totalPages ? 'disabled class="opacity-40 cursor-not-allowed"' : ''}
                        class="px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-xs font-bold transition">
                        Selanjutnya
                    </button>
                `;

            } catch (e) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="text-center py-8 text-rose-500">
                            Gagal memuat transaksi: ${e.message}
                            <button onclick="fetchTransactions(1)" class="block mx-auto mt-2 text-xs font-bold underline">Coba Lagi</button>
                        </td>
                    </tr>
                `;
            }
        }

        // --- Transaction Detail Drawer Handler ---
        async function openTransactionDrawer(id) {
            try {
                const res = await fetch(`/api/transaction/${id}`);
                const data = await res.json();
                if (!data.success || !data.transaction) {
                    showToast('Detail transaksi tidak ditemukan', 'error');
                    return;
                }

                const tx = data.transaction;
                const pub = data.publicData || {};

                document.getElementById('drawer-tx-order-id').innerText = tx.orderId || tx.order_id || tx.id;
                document.getElementById('drawer-tx-id').innerText = tx.id;
                document.getElementById('drawer-tx-trx-id').innerText = tx.trxId || tx.trx_id || '-';
                document.getElementById('drawer-tx-name').innerText = tx.customName || tx.custom_name || '-';
                document.getElementById('drawer-tx-total-amount').innerText = formatRupiah(tx.totalAmount || tx.total_amount);
                document.getElementById('drawer-tx-amount-breakdown').innerText = `Nominal Dasar: ${formatRupiah(tx.baseAmount || tx.base_amount)} • Kode Unik: ${formatRupiah(tx.uniqueCode || tx.unique_code || 0)}`;
                document.getElementById('drawer-tx-created').innerText = formatDate(tx.createdAt || tx.created_at);
                document.getElementById('drawer-tx-expires').innerText = formatDate(tx.expiresAt || tx.expires_at);
                document.getElementById('drawer-tx-paid').innerText = formatDate(tx.paidAt || tx.paid_at);
                
                const isSent = tx.webhookSent || tx.webhook_sent;
                document.getElementById('drawer-tx-webhook-status').innerHTML = isSent 
                    ? `<span class="text-emerald-500 font-bold"><i class="fa-solid fa-check"></i> Terkirim</span>` 
                    : `<span class="text-slate-400 font-medium">Belum / Tidak ada webhook</span>`;

                const isPaid = (tx.status || '').toUpperCase() === 'PAID';
                const isPending = (tx.status || '').toUpperCase() === 'PENDING';
                const badgeEl = document.getElementById('drawer-tx-status-badge');
                if (isPaid) {
                    badgeEl.className = 'px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700';
                    badgeEl.innerText = 'LUNAS (PAID)';
                } else if (isPending) {
                    badgeEl.className = 'px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-700';
                    badgeEl.innerText = 'MENUNGGU PEMBAYARAN';
                } else {
                    badgeEl.className = 'px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600';
                    badgeEl.innerText = 'KEDALUWARSA (EXPIRED)';
                }

                // QR preview
                document.getElementById('drawer-tx-qr-img').src = tx.qrImage || tx.qr_image || '';
                document.getElementById('drawer-tx-qris-code').value = tx.qrisCode || tx.qris_code || '';

                // Customer Checkout Link
                const invLink = document.getElementById('drawer-tx-open-invoice');
                if (pub.checkout_url) {
                    invLink.href = pub.checkout_url;
                    invLink.classList.remove('hidden');
                } else {
                    invLink.href = `/payment/x/${tx.id}`;
                    invLink.classList.remove('hidden');
                }

                document.getElementById('drawer-transaction').classList.remove('hidden');
            } catch (e) {
                showToast('Gagal membuka drawer: ' + e.message, 'error');
            }
        }

