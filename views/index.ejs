                        </div>

                        <!-- Status Filter Tabs (3 Cols) -->
                        <div class="sm:col-span-3">
                            <select id="tx-status-select" onchange="fetchTransactions(1)"
                                class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900/90 border border-slate-200 dark:border-fintech-darkBorder rounded-2xl text-xs font-bold text-slate-700 dark:text-slate-200 focus:outline-none focus:border-fintech-blue transition">
                                <option value="ALL">Semua Status</option>
                                <option value="PAID">Sukses (PAID)</option>
                                <option value="PENDING">Menunggu (PENDING)</option>
                                <option value="EXPIRED">Kedaluwarsa (EXPIRED)</option>
                            </select>
                        </div>

                        <!-- Sorting Options (3 Cols) -->
                        <div class="sm:col-span-3">
                            <select id="tx-sort-select" onchange="fetchTransactions(1)"
                                class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900/90 border border-slate-200 dark:border-fintech-darkBorder rounded-2xl text-xs font-bold text-slate-700 dark:text-slate-200 focus:outline-none focus:border-fintech-blue transition">
                                <option value="created_at-desc">Waktu: Terbaru</option>
                                <option value="created_at-asc">Waktu: Terlama</option>
                                <option value="total_amount-desc">Nominal: Tertinggi</option>
                                <option value="total_amount-asc">Nominal: Terendah</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Main Transactions Table Card -->
                <div class="bg-white dark:bg-fintech-darkCard rounded-3xl border border-slate-200 dark:border-fintech-darkBorder shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50/70 dark:bg-slate-900/50 border-b border-slate-100 dark:border-fintech-darkBorder text-[11px] font-extrabold uppercase tracking-wider text-slate-400">
