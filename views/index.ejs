                        <div id="tx-pagination-info" class="font-medium">
                            Menampilkan halaman 1 dari 1
                        </div>
                        <div class="flex items-center gap-1.5" id="tx-pagination-buttons">
                            <!-- Prev/Next buttons added by JS -->
                        </div>
                    </div>
                </div>

            </section>

            <!-- ========================================================= -->
            <!-- SECTION 3: FINANCIAL INTERFACE & SETTLEMENT               -->
            <!-- ========================================================= -->
            <section id="section-financial" class="view-section space-y-6 hidden animate-fade-in">
                
                <!-- Financial Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                        <h3 class="text-base font-black text-slate-900 dark:text-white">Laporan Keuangan & Rekapitulasi</h3>
                        <p class="text-xs text-slate-400 dark:text-fintech-darkSubtext">Ikhtisar pendapatan bersih, bebas biaya potongan QRIS, dan mutasi settlement</p>
