                            <button onclick="switchCodeTab('php')" id="btn-code-php" class="code-tab-btn px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-bold">PHP</button>
                            <button onclick="switchCodeTab('python')" id="btn-code-python" class="code-tab-btn px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-bold">Python</button>
                        </div>
