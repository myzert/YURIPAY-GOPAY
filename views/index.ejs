        // --- Kasir POS Controller ---
        function setNominal(amt) {
            document.getElementById('input-nominal').value = amt;
        }

        async function handleGenerateQR(openDirectly = false) {
            const nominal = parseInt(document.getElementById('input-nominal').value, 10);
            if (isNaN(nominal) || nominal < 50) {
                showToast('Masukkan nominal valid minimal Rp 50', 'error');
                return;
            }

            const orderId = document.getElementById('input-order-id').value.trim();
            const customName = document.getElementById('input-custom-name').value.trim();
            const useUniqueCode = document.getElementById('input-use-unique').checked;

            try {
                showToast('Menghasilkan tagihan QRIS...', 'info');
                const res = await fetch('/api/create-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        nominal,
                        order_id: orderId || undefined,
                        custom_name: customName || undefined,
                        use_unique_code: useUniqueCode
                    })
                });
                const result = await res.json();
                if (!result.success || !result.data) {
                    showToast(result.message || 'Gagal membuat tagihan', 'error');
                    return;
                }

                const payment = result.data;
                activePosPaymentId = payment.id;

                if (openDirectly && payment.checkout_url) {
                    window.open(payment.checkout_url, '_blank');
                }

                // Render in right POS box
                document.getElementById('pos-empty-preview').classList.add('hidden');
                document.getElementById('pos-active-preview').classList.remove('hidden');
                document.getElementById('pos-qr-img').src = payment.qr_image;
                document.getElementById('pos-amount-display').innerText = formatRupiah(payment.total_amount);

                // Start polling payment status every 2.5s
                clearInterval(posPollInterval);
                posPollInterval = setInterval(() => {
                    checkCurrentPosStatus();
                }, 2500);

                showToast(`Tagihan QRIS ${formatRupiah(payment.total_amount)} siap discan!`, 'success');
                refreshDashboardData();

            } catch (e) {
                showToast('Kesalahan koneksi: ' + e.message, 'error');
            }
        }

        async function checkCurrentPosStatus() {
            if (!activePosPaymentId) return;
            try {
                const res = await fetch(`/api/check-payment/${activePosPaymentId}`);
                const data = await res.json();
                if (data.paid || data.status === 'PAID') {
                    clearInterval(posPollInterval);
                    playSoundbox();
                    launchConfetti();
                    document.getElementById('celebration-amount').innerText = formatRupiah(data.total_amount || 0);
                    document.getElementById('celebration-modal').classList.remove('hidden');
                    document.getElementById('pos-status-badge').className = 'px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700';
                    document.getElementById('pos-status-badge').innerText = 'LUNAS (PAID)';
                    refreshDashboardData();
                } else if (data.status === 'EXPIRED') {
                    clearInterval(posPollInterval);
                    document.getElementById('pos-status-badge').className = 'px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600';
                    document.getElementById('pos-status-badge').innerText = 'KEDALUWARSA';
                }
            } catch (e) {}
        }

