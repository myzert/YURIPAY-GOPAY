                            <input type="url" id="test-webhook-url" placeholder="https://toko-anda.com/api/payment-callback"
                                class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-900/90 border border-slate-200 dark:border-fintech-darkBorder rounded-xl text-xs font-medium text-slate-900 dark:text-white">
                        </div>
                        <div class="sm:col-span-4">
                            <button onclick="dispatchTestWebhook()"
                                class="w-full py-2.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold transition shadow-sm">
                                Kirim Simulasi Notifikasi
                            </button>
                        </div>
                    </div>
                </div>

