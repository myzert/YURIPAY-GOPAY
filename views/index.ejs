                                    <th class="py-3 px-4 text-right">Detail</th>
                                </tr>
                            </thead>
                            <tbody id="logs-table-tbody" class="divide-y divide-slate-100 dark:divide-fintech-darkBorder/60 font-medium">
                                <!-- Populated dynamically by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </section>

            <!-- ========================================================= -->
