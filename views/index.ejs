<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= appName %> • Self-Hosted Financial Dashboard</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            200: '#bfdbfe',
                            300: '#93c5fd',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#1d4ed8',
                            700: '#1e40af',
                            800: '#1e3a8a',
                            900: '#172554'
                        },
                        fintech: {
                            blue: '#1a73e8',
                            blueHover: '#1557b0',
                            emerald: '#059669',
                            emeraldHover: '#047857',
                            amber: '#d97706',
                            rose: '#e11d48',
                            darkBg: '#090d16',
                            darkCard: '#111827',
                            darkBorder: '#1f293d',
                            darkSubtext: '#94a3b8'
                        }
                    }
                }
            }
        }
    </script>

    <!-- Font Awesome 6.5.1 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

    <style>
        body {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }
        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.3);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(148, 163, 184, 0.5);
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        /* Pulse glow animation for status pills */
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
            50% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        }
        .pulse-live {
            animation: pulseGlow 2s infinite;
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-fintech-darkBg text-slate-800 dark:text-slate-100 min-h-screen flex transition-colors duration-200 antialiased overflow-x-hidden">

    <!-- Audio Element for Soundbox feedback -->
    <audio id="soundbox-audio-local" src="/sounds/cute-arigato.mp3" preload="auto"></audio>
    <audio id="soundbox-audio-online" src="https://assets.mixkit.co/active_storage/sfx/2874/2874-preview.mp3" preload="auto"></audio>

    <!-- ========================================================= -->
    <!-- 1. CONSISTENT SIDEBAR NAVIGATION (DESKTOP & MOBILE)        -->
    <!-- ========================================================= -->
    <aside id="sidebar-container"
        class="fixed inset-y-0 left-0 z-50 w-72 bg-white dark:bg-fintech-darkCard border-r border-slate-200 dark:border-fintech-darkBorder flex flex-col justify-between transition-transform duration-300 ease-in-out -translate-x-full lg:translate-x-0 shadow-lg lg:shadow-none">
        
        <!-- Sidebar Header (Brand & Logo) -->
        <div>
            <div class="h-20 px-6 flex items-center justify-between border-b border-slate-100 dark:border-fintech-darkBorder/60">
                <div class="flex items-center space-x-3.5">
                    <% if (typeof storeLogoUrl !== 'undefined' && storeLogoUrl) { %>
                        <img src="<%= storeLogoUrl %>" alt="<%= appName %>" class="w-10 h-10 rounded-2xl object-cover shadow-sm border border-slate-200 dark:border-fintech-darkBorder">
                    <% } else { %>
                        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-blue-600 to-sky-400 text-white flex items-center justify-center text-lg shadow-md shadow-blue-500/25">
                            <i class="fa-solid fa-bolt-lightning"></i>
                        </div>
                    <% } %>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="font-black text-lg tracking-tight text-slate-900 dark:text-white"><%= appName %></span>
                            <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-blue-50 dark:bg-blue-950 text-fintech-blue dark:text-sky-400 border border-blue-200 dark:border-blue-900">PRO</span>
                        </div>
                        <p class="text-[11px] font-semibold text-slate-400 dark:text-fintech-darkSubtext flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                            <span id="sidebar-store-name"><%= storeName %> Console</span>
                        </p>
                    </div>
                </div>

                <!-- Close mobile sidebar button -->
                <button onclick="toggleSidebar(false)" aria-label="Tutup Menu" class="lg:hidden w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-600 dark:hover:text-white transition active:scale-95">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Navigation Links -->
            <nav class="p-4 space-y-1.5 overflow-y-auto max-h-[calc(100vh-190px)]">
                <p class="px-3 pt-2 pb-1 text-[10px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">Menu Utama</p>
                
                <!-- 1. Overview / Dashboard -->
                <button onclick="switchView('overview')" id="nav-overview"
                    class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/80">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-chart-pie w-4 text-center text-sm text-slate-400 nav-icon"></i>
                        <span>Ringkasan Dashboard</span>
                    </div>
                    <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">Live</span>
                </button>

                <!-- 2. Transactions Interface -->
                <button onclick="switchView('transactions')" id="nav-transactions"
                    class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/80">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-receipt w-4 text-center text-sm text-slate-400 nav-icon"></i>
                        <span>Manajemen Transaksi</span>
                    </div>
                    <span id="badge-total-trx" class="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300"><%= stats.allTotal %></span>
                </button>

                <!-- 3. Financial Interface -->
                <button onclick="switchView('financial')" id="nav-financial"
                    class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/80">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-wallet w-4 text-center text-sm text-slate-400 nav-icon"></i>
                        <span>Laporan Keuangan & Mutasi</span>
                    </div>
                    <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300">0% MDR</span>
                </button>

                <!-- 4. Kasir POS & QRIS Dinamis -->
                <button onclick="switchView('pos')" id="nav-pos"
                    class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/80">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-cash-register w-4 text-center text-sm text-slate-400 nav-icon"></i>
                        <span>Kasir POS & Dynamic QR</span>
                    </div>
                    <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300">Soundbox</span>
                </button>

                <p class="px-3 pt-4 pb-1 text-[10px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">Pusat Sistem</p>

                <!-- 5. Logging System -->
                <button onclick="switchView('logs')" id="nav-logs"
                    class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/80">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-list-check w-4 text-center text-sm text-slate-400 nav-icon"></i>
                        <span>Pusat Log & Audit Trail</span>
                    </div>
                    <span class="w-2 h-2 rounded-full bg-sky-500"></span>
                </button>

                <!-- 6. Developer & API Keys -->
                <button onclick="switchView('developer')" id="nav-developer"
                    class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/80">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-code w-4 text-center text-sm text-slate-400 nav-icon"></i>
                        <span>Sandbox API & Keys</span>
                    </div>
                </button>

                <!-- 7. Security & Admin Account -->
                <button onclick="switchView('security')" id="nav-security"
                    class="nav-item w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/80">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-shield-halved w-4 text-center text-sm text-slate-400 nav-icon"></i>
                        <span>Keamanan & Akun Admin</span>
                    </div>
                </button>
            </nav>
        </div>

        <!-- Sidebar Footer: Session Status & Profile Card -->
        <div class="p-4 border-t border-slate-100 dark:border-fintech-darkBorder/60 space-y-3">
            <!-- GoPay Realtime Health Indicator -->
            <div class="p-2.5 rounded-2xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200/80 dark:border-fintech-darkBorder flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full <%= sessionValid ? 'bg-emerald-500 pulse-live' : 'bg-amber-500' %>"></span>
                    <div>
                        <p class="text-[11px] font-extrabold text-slate-800 dark:text-slate-200"><%= sessionValid ? 'GoPay Gateway Online' : 'GoPay Siaga' %></p>
                        <p class="text-[9px] text-slate-400 font-mono">Port <%= dashboardPort %> & <%= paymentPort %></p>
                    </div>
                </div>
                <button onclick="refreshDashboardData()" title="Sinkronisasi Data" class="w-7 h-7 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center hover:bg-slate-200 dark:hover:bg-slate-800 transition">
                    <i id="sync-icon" class="fa-solid fa-arrows-rotate text-xs"></i>
                </button>
            </div>

            <!-- Admin Info & Quick Logout -->
            <div class="flex items-center justify-between pt-1">
                <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-8 h-8 rounded-xl bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center text-xs font-bold shrink-0">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate"><%= adminEmail %></p>
                        <p class="text-[10px] text-slate-400 truncate">Super Administrator</p>
                    </div>
                </div>
                <a href="/logout" title="Keluar / Logout" class="w-8 h-8 rounded-xl bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/40 dark:hover:bg-rose-950/80 text-rose-600 dark:text-rose-400 flex items-center justify-center transition shrink-0">
                    <i class="fa-solid fa-arrow-right-from-bracket text-xs"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- Mobile Sidebar Backdrop Overlay -->
    <div id="sidebar-backdrop" onclick="toggleSidebar(false)" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 hidden lg:hidden transition-opacity"></div>

    <!-- ========================================================= -->
    <!-- 2. MAIN APPLICATION CONTENT WRAPPER                        -->
    <!-- ========================================================= -->
    <div class="flex-1 lg:pl-72 flex flex-col min-h-screen min-w-0">

        <!-- Top Header Bar -->
        <header class="h-20 bg-white/80 dark:bg-fintech-darkCard/80 backdrop-blur-md border-b border-slate-200 dark:border-fintech-darkBorder px-4 sm:px-8 sticky top-0 z-30 flex items-center justify-between">
            
            <!-- Left Header: Mobile Toggle & Breadcrumbs -->
            <div class="flex items-center gap-3 min-w-0">
                <button onclick="toggleSidebar(true)" aria-label="Buka Menu Navigasi" class="lg:hidden w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 flex items-center justify-center transition active:scale-95 border border-slate-200/80 dark:border-slate-700/80 shadow-sm">
                    <i class="fa-solid fa-bars text-base"></i>
                </button>
                <div>
                    <nav class="flex items-center gap-1.5 text-[11px] font-semibold text-slate-400 dark:text-fintech-darkSubtext">
                        <span class="hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer" onclick="switchView('overview')"><%= appName %></span>
                        <span>/</span>
                        <span id="breadcrumb-current" class="text-slate-800 dark:text-white font-bold">Ringkasan Dashboard</span>
                    </nav>
                    <h2 id="page-title" class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white truncate">Ringkasan Keuangan & Gateway</h2>
                </div>
            </div>

            <!-- Right Header Actions -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Soundbox Test Button -->
                <button onclick="testSoundboxVoice()"
                    class="hidden sm:flex items-center gap-2 px-3.5 py-2 rounded-xl bg-pink-50 hover:bg-pink-100 dark:bg-pink-950/40 dark:hover:bg-pink-950/70 text-pink-700 dark:text-pink-300 text-xs font-bold transition border border-pink-200/80 dark:border-pink-900/50 shadow-sm active:scale-95">
                    <i class="fa-solid fa-volume-high text-pink-500"></i>
                    <span>Uji Soundbox</span>
                </button>

                <!-- Quick CSV Export Button -->
                <a href="/api/financial/export-csv"
                    class="hidden md:flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition border border-slate-200 dark:border-slate-700 shadow-sm">
                    <i class="fa-solid fa-file-csv text-emerald-600"></i>
                    <span>Ekspor CSV</span>
                </a>

                <!-- Theme Toggle Button -->
                <button onclick="toggleDarkMode()"
                    class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-amber-400 flex items-center justify-center transition border border-slate-200 dark:border-slate-700 shadow-sm"
                    title="Ganti Mode Tampilan (Terang/Gelap)">
                    <i id="theme-icon" class="fa-solid fa-moon"></i>
                </button>

                <!-- Header Logout Button -->
                <a href="/logout"
                    class="w-10 h-10 rounded-xl bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/40 dark:hover:bg-rose-950/80 text-rose-600 dark:text-rose-400 flex items-center justify-center transition border border-rose-200 dark:border-rose-900/50 shadow-sm"
                    title="Keluar / Logout Admin">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        </header>

        <!-- Main Workspace Area -->
        <main class="flex-1 p-4 sm:p-8 max-w-7xl w-full mx-auto space-y-8">

            <!-- Global Toast Container (Alert & Success States) -->
            <div id="toast-container" class="fixed top-24 right-4 sm:right-8 z-50 flex flex-col gap-2 pointer-events-none"></div>

            <!-- ========================================================= -->
            <!-- SECTION 1: RINGKASAN DASHBOARD (OVERVIEW)                 -->
            <!-- ========================================================= -->
            <section id="section-overview" class="view-section space-y-6 animate-fade-in">
                
                <!-- Financial Statistics 4 Top Cards -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
                    
                    <!-- Card 1: Omset Hari Ini -->
                    <div class="bg-white dark:bg-fintech-darkCard rounded-3xl p-5 border border-slate-200 dark:border-fintech-darkBorder shadow-sm hover:shadow-md transition">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-fintech-darkSubtext">Omset Hari Ini</span>
                            <div class="w-10 h-10 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-base">
                                <i class="fa-solid fa-wallet"></i>
                            </div>
                        </div>
                        <h3 id="stat-today-volume" class="text-2xl sm:text-3xl font-black font-mono text-emerald-600 dark:text-emerald-400 mt-2">
                            <%= formatRupiah(stats.todayVolume) %>
                        </h3>
                        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 flex items-center justify-between">
                            <span>Total Seluruh:</span>
                            <strong id="stat-all-volume" class="font-mono text-slate-700 dark:text-slate-300"><%= formatRupiah(stats.allVolume) %></strong>
                        </p>
                    </div>

                    <!-- Card 2: Transaksi Sukses -->
                    <div class="bg-white dark:bg-fintech-darkCard rounded-3xl p-5 border border-slate-200 dark:border-fintech-darkBorder shadow-sm hover:shadow-md transition">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-fintech-darkSubtext">Transaksi Sukses</span>
                            <div class="w-10 h-10 rounded-2xl bg-blue-50 dark:bg-blue-950/50 text-fintech-blue dark:text-sky-400 flex items-center justify-center text-base">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                        </div>
                        <h3 id="stat-today-success" class="text-2xl sm:text-3xl font-black font-mono text-fintech-blue dark:text-sky-400 mt-2">
                            <%= stats.todaySuccess %> <span class="text-xs font-normal text-slate-400">/ <%= stats.todayTotal %> trx</span>
                        </h3>
                        <p class="text-xs text-emerald-600 dark:text-emerald-400 font-bold mt-1 flex items-center gap-1.5">
                            <i class="fa-solid fa-arrow-trend-up"></i>
                            <span id="stat-success-rate"><%= stats.successRate %>%</span> Tingkat Keberhasilan
                        </p>
                    </div>

                    <!-- Card 3: Menunggu Pembayaran (Pending) -->
                    <div class="bg-white dark:bg-fintech-darkCard rounded-3xl p-5 border border-slate-200 dark:border-fintech-darkBorder shadow-sm hover:shadow-md transition">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-fintech-darkSubtext">Menunggu (PENDING)</span>
                            <div class="w-10 h-10 rounded-2xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center text-base">
                                <i class="fa-solid fa-hourglass-half"></i>
                            </div>
                        </div>
                        <h3 id="stat-today-pending" class="text-2xl sm:text-3xl font-black font-mono text-amber-600 dark:text-amber-400 mt-2">
                            <%= stats.todayPending %>
                        </h3>
                        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 flex items-center justify-between">
                            <span>Antrean Aktif:</span>
                            <strong id="stat-all-pending" class="font-mono text-slate-700 dark:text-slate-300"><%= stats.allPending %></strong>
                        </p>
                    </div>

                    <!-- Card 4: Kedaluwarsa (Expired) -->
                    <div class="bg-white dark:bg-fintech-darkCard rounded-3xl p-5 border border-slate-200 dark:border-fintech-darkBorder shadow-sm hover:shadow-md transition">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400 dark:text-fintech-darkSubtext">Kedaluwarsa (EXPIRED)</span>
                            <div class="w-10 h-10 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 flex items-center justify-center text-base">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                            </div>
                        </div>
                        <h3 id="stat-today-expired" class="text-2xl sm:text-3xl font-black font-mono text-slate-600 dark:text-slate-400 mt-2">
                            <%= stats.todayExpired || 0 %>
                        </h3>
                        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 flex items-center justify-between">
                            <span>Total Batal:</span>
                            <strong id="stat-all-expired" class="font-mono text-slate-700 dark:text-slate-300"><%= stats.allExpired || 0 %></strong>
                        </p>
                    </div>
                </div>

                <!-- Traffic Distribution & Rate Bar -->
                <div class="bg-white dark:bg-fintech-darkCard rounded-3xl p-6 border border-slate-200 dark:border-fintech-darkBorder shadow-sm space-y-3">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-chart-column text-fintech-blue dark:text-sky-400"></i>
                            <h4 class="text-sm font-extrabold text-slate-900 dark:text-white">Rasio Distribusi Status Transaksi</h4>
                        </div>
                        <span id="traffic-total-label" class="text-xs font-mono font-bold text-slate-400">
                            Total <%= stats.allTotal %> Transaksi Keseluruhan
                        </span>
                    </div>

                    <!-- Visual Segmented Bar -->
                    <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-3 overflow-hidden flex shadow-inner">
                        <div id="bar-success" class="bg-emerald-500 h-full transition-all duration-500" style="width: <%= stats.allTotal > 0 ? (stats.allSuccess / stats.allTotal * 100) : 50 %>%;"></div>
                        <div id="bar-pending" class="bg-amber-500 h-full transition-all duration-500" style="width: <%= stats.allTotal > 0 ? (stats.allPending / stats.allTotal * 100) : 30 %>%;"></div>
                        <div id="bar-expired" class="bg-slate-400 dark:bg-slate-600 h-full transition-all duration-500" style="width: <%= stats.allTotal > 0 ? (stats.allExpired / stats.allTotal * 100) : 20 %>%;"></div>
                    </div>

                    <!-- Legend & Realtime Pulse -->
                    <div class="flex flex-wrap items-center justify-between gap-4 text-xs pt-1">
                        <div class="flex items-center gap-4 text-slate-600 dark:text-slate-400">
                            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Sukses: <strong id="legend-success" class="text-slate-800 dark:text-slate-200"><%= stats.allSuccess %></strong></span>
