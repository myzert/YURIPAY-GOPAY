# =================================================================
# YURIPAY - ENTERPRISE QRIS PAYMENT GATEWAY CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# 1. PORT & JARINGAN (DUAL-PORT ISOLATION)
# -----------------------------------------------------------------
# Port Internal Dashboard Admin & Kasir (Bebas / Default 3000)
DASHBOARD_PORT=3000

# Port Publik Customer Checkout Gateway (Port terisolasi / Default 3001)
PAYMENT_PORT=3001

# URL Domain Publik Produksi (Wajib diisi jika menggunakan reverse proxy / Nginx / Cloudflare)
# Hindari mengekspos localhost di produksi. Contoh: https://pay.domainanda.com
PAYMENT_BASE_URL=https://pay.domainanda.com

# URL Domain Admin Internal Produksi (Opsional, contoh: https://admin.domainanda.com)
DASHBOARD_BASE_URL=https://admin.domainanda.com

# Stealth Auto-Redirect URL (Pengalihan pelindung anti-bot scanner)
# Jika root port 3001 dibuka tanpa ID tagihan, otomatis dialihkan ke website utama Anda
PAYMENT_ROOT_REDIRECT_URL=https://tokosaya.com

# -----------------------------------------------------------------
# 2. IDENTITAS TOKO & BRANDING (STORE IDENTITY)
# -----------------------------------------------------------------
STORE_NAME=YuriDev
APP_NAME="YURIPAY by myzert"
STORE_WEBSITE_URL=https://tokosaya.com
# URL Gambar Logo Toko Anda (PNG/WEBP/JPG)
STORE_LOGO_URL=""
# Tema Notifikasi Sukses Bayar: "anime" (Cute Marin Kitagawa) atau "default" (Corporate fintech sound chime)
DEFAULT_SUCCESS_THEME="anime"

# -----------------------------------------------------------------
# 3. KREDENSIAL API & SECURITY TOKEN (DEVELOPER CREDENTIALS)
# -----------------------------------------------------------------
# Kunci Publik (Client Key) - Aman digunakan di frontend/kasir klien
API_PUBLIC_KEY=pk_live_change_me_or_generate_in_dashboard

# Kunci Rahasia (Server Secret Key) - Wajib dirahasiakan, digunakan backend call & webhook HMAC SHA-512
API_SECRET_KEY=sk_live_change_me_or_generate_in_dashboard

# Kompatibilitas Legacy API Key
API_KEY=sk_live_change_me_or_generate_in_dashboard

# -----------------------------------------------------------------
# 4. AUTENTIKASI DASHBOARD ADMIN (PORT 3000)
# -----------------------------------------------------------------
ADMIN_EMAIL=admin@tokosaya.com
ADMIN_PASSWORD=buat_password_admin_yang_sangat_kuat_123
SESSION_SECRET=acak_string_rahasia_sesi_minimal_32_karakter_random

# -----------------------------------------------------------------
# 5. INTEGRASI GOBIZ MERCHANT (PRIVATE SESI GATEWAY)
# -----------------------------------------------------------------
# Kode QRIS Statis Toko Anda dari aplikasi GoBiz (Lainnya -> QRIS Toko -> Scan)
QRIS_STATIC=00020101021126610014COM.GO-JEK.WWW...
# Batas minimal dan masa berlaku tagihan
MIN_NOMINAL=50
TRANSACTION_TIMEOUT_MINUTES=10
